{
    "name": "sumutmengajar/sumut-mengajar",
    "description": "Website dan Sistem Rekrutmen Gerakan Sumut Mengajar",
    "type": "project",
    "license": "BSD-3-Clause",
    "minimum-stability": "stable",
    "prefer-stable": true,

    "require": {
        "php": "^8.2",
        "yiisoft/yii2": "^2.0.55",
        "yiisoft/yii2-bootstrap": "^2.0.11",
        "mdmsoft/yii2-admin": "2.12",
        "dmstr/yii2-adminlte-asset": "2.6.2"
    },

    "config": {
        "process-timeout": 1800,
        "allow-plugins": {
            "yiisoft/yii2-composer": true
        }
    },

    "repositories": [
        {
            "type": "composer",
            "url": "https://asset-packagist.org"
        }
    ]
}
